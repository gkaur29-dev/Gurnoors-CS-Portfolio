<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Oops! Page Not Found</title>
    <style>
        body {
            margin: 0;
            padding: 0;
            height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            background: linear-gradient(135deg, #fce4ec, #e8f5e9);
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            overflow: hidden;
            position: relative;
        }

        /* Floating Emoji Background */
        .emoji {
            position: absolute;
            font-size: 2rem;
            user-select: none;
            z-index: 1;
            animation: float 6s ease-in-out infinite;
            opacity: 0.6;
        }

        @keyframes float {
            0%, 100% { transform: translateY(0) rotate(0deg); }
            50% { transform: translateY(-30px) rotate(20deg); }
        }

        /* The Pop-up Card */
        .card {
            background: white;
            padding: 2.5rem;
            border-radius: 25px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.05);
            text-align: center;
            z-index: 10;
            max-width: 400px;
            border: 4px solid #fff;
        }

        h1 {
            color: #f06292;
            margin-bottom: 10px;
            font-size: 1.8rem;
        }

        p {
            color: #66bb6a;
            font-weight: 500;
            margin-bottom: 25px;
        }

        .btn {
            background-color: #f06292;
            color: white;
            text-decoration: none;
            padding: 12px 25px;
            border-radius: 50px;
            font-weight: bold;
            transition: transform 0.2s;
            display: inline-block;
        }

        .btn:hover {
            transform: scale(1.05);
            background-color: #ec407a;
        }
    </style>
</head>
<body>

    <div class="emoji" style="top: 15%; left: 10%; animation-delay: 0s;">🌸</div>
    <div class="emoji" style="top: 70%; left: 20%; animation-delay: 1s;">🌿</div>
    <div class="emoji" style="top: 25%; left: 80%; animation-delay: 2s;">🎀</div>
    <div class="emoji" style="top: 80%; left: 75%; animation-delay: 1.5s;">🍃</div>
    <div class="emoji" style="top: 40%; left: 50%; animation-delay: 0.5s;">✨</div>

    <div class="card">
        <h1>Oops!</h1>
        <p>Theres no page for this... Sorry about that!</p>
        <a href="#" class="btn">Check out another game!</a>
    </div>

</body>
</html>
